# === Провайдеры LLM (OpenAI-совместимые) ===
# Primary: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback: RouterAI (РФ)
ROUTERAI_API_KEY=sk-your-routerai-api-key
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# === Модель LLM ===
# По умолчанию используется qwen/qwen3.7-flash (RouterAI: 3,10₽/13₽ за 1M)
LLM_MODEL=qwen/qwen3.7-flash
# Переопределение модели для исследовательского агента (опционально)
RESEARCHER_MODEL=qwen/qwen3.7-flash

# === Приоритет провайдера и модели ===
# Провайдер по умолчанию: 'routerai' или 'openrouter' (остальные — fallback)
LLM_PRIMARY_PROVIDER=routerai
# Модели для каждого провайдера (если не заданы — используется LLM_MODEL)
ROUTERAI_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Дополнительные fallback-модели через запятую (если основная модель недоступна)
FALLBACK_MODELS=deepseek/deepseek-v4-flash-0731,qwen/qwen3.7-flash

# === Поиск: Yandex Search API (Yandex Cloud) ===
# Документация: https://cloud.yandex.com/docs/search-api/
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id

# === Tavily Search API (fallback, используется только если указан ключ) ===
TAVILY_API_KEY=

# === Лимиты и таймауты агента ===
MAX_STEPS=5
MAX_COST_USD=0.5
REQUEST_TIMEOUT=30

# === Phoenix Observability ===
# true — запускать локальный Phoenix (http://localhost:6006) и трассировать LLM
PHOENIX_ENABLED=true

# === Оценка стоимости (fallback, если провайдер не вернул usage.total_cost) ===
# Цены за 1M токенов для deepseek/deepseek-v4-flash (приблизительно, USD, для OpenRouter и др.)
COST_PER_1M_PROMPT=0.14
COST_PER_1M_COMPLETION=0.28
# RouterAI — цены в рублях за 1M токенов (deepseek flash: 9₽/18₽; qwen3.7-flash: 3,10₽/13₽)
ROUTERAI_COST_PER_1M_PROMPT_RUB=9.0
ROUTERAI_COST_PER_1M_COMPLETION_RUB=18.0
QWEN_COST_PER_1M_PROMPT_RUB=3.1
QWEN_COST_PER_1M_COMPLETION_RUB=13.0
# Курс рубль→доллар (по умолчанию ~90₽/$)
RUB_TO_USD_RATE=0.0111
